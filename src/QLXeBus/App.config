<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Giá trị mặc định chung cho nhóm. Mật khẩu KHÔNG đặt ở đây: mỗi máy nhập qua màn hình
         đăng nhập > "Kết nối CSDL..." (lưu vào %AppData%\QLXeBus\dbconfig.ini). -->
    <add key="Host" value="localhost" />
    <add key="Port" value="5432" />
    <add key="Database" value="HQTCSDL" />
    <add key="Username" value="postgres" />
    <add key="PgDumpPath" value="pg_dump" />
  </appSettings>
</configuration>
